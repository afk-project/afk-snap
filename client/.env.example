# =============================================================
# AFKSnap Frontend Environment
# Salin file ini menjadi: client/.env
# Semua variabel VITE_ dapat terlihat di browser. Jangan menaruh secret key.
# =============================================================

VITE_API_URL=http://localhost:3000/api
VITE_SERVER_URL=http://localhost:3000

# Google OAuth Web Client ID. Nilainya sama dengan GOOGLE_CLIENT_ID di server/.env.
VITE_GOOGLE_CLIENT_ID=

# Jangan masukkan OPENAI_API_KEY, MIDTRANS_SERVER_KEY, SECRET_KEY,
# atau password database ke file frontend ini.
