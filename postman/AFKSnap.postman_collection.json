{
  "info": {
    "_postman_id": "8f8db348-28d8-4f74-91a2-af5a9a202609",
    "name": "AFKSnap API - Fullstack",
    "description": "REST API collection AFKSnap v1.1. Jalankan Login Demo untuk menyimpan accessToken otomatis. Create Room menyimpan roomId/roomCode, upload menyimpan assetId, generation menyimpan generationId, dan checkout menyimpan orderId. Folder 08 menguji kontrak error standar { status, error, message }. Event Socket.IO realtime diuji memakai panduan docs/POSTMAN_SOCKET_IO_GUIDE.md karena Postman memisahkan koleksi HTTP dan Socket.IO.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiUrl", "value": "{{baseUrl}}/api" },
    { "key": "socketUrl", "value": "ws://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "roomId", "value": "1" },
    { "key": "roomCode", "value": "" },
    { "key": "assetId", "value": "1" },
    { "key": "generationId", "value": "1" },
    { "key": "orderId", "value": "" },
    { "key": "redirectUrl", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Memeriksa status API serta mode/model AI."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('API sehat', () => pm.response.to.have.status(200));", "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register New User",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["const email = `arief.postman.${Date.now()}@example.com`;", "pm.collectionVariables.set('testEmail', email);"] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Register berhasil', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);"] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arief Postman\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123!\",\n  \"passwordConfirmation\": \"Password123!\",\n  \"birthday\": \"1998-01-20\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{apiUrl}}/auth/register"
          }
        },
        {
          "name": "Login Demo",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Login berhasil', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.collectionVariables.set('accessToken', json.access_token);"] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@afksnap.id\",\n  \"password\": \"Demo123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{apiUrl}}/auth/login"
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Login admin berhasil', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.collectionVariables.set('adminToken', json.access_token);"] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@afksnap.id\",\n  \"password\": \"Admin123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{apiUrl}}/auth/login"
          }
        },
        {
          "name": "Google Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"credential\": \"PASTE_GOOGLE_ID_TOKEN\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{apiUrl}}/auth/google",
            "description": "Ganti credential dengan Google ID token dari frontend Google OAuth."
          }
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.devResetUrl) {", "  const token = new URL(json.devResetUrl).searchParams.get('token');", "  if (token) pm.collectionVariables.set('resetToken', token);", "}"] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@afksnap.id\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{apiUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"PasswordBaru123!\",\n  \"passwordConfirmation\": \"PasswordBaru123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{apiUrl}}/auth/reset-password"
          }
        }
      ]
    },
