        },
        {
          "name": "Midtrans Notification Example",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{orderId}}\",\n  \"status_code\": \"200\",\n  \"gross_amount\": \"650000.00\",\n  \"transaction_status\": \"settlement\",\n  \"fraud_status\": \"accept\",\n  \"signature_key\": \"REPLACE_WITH_VALID_SHA512_SIGNATURE\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{apiUrl}}/payments/notification",
