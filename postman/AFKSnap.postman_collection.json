    {
      "name": "08 - Error Handling Tests",
      "description": "Jalankan Login Demo dan Create Room terlebih dahulu untuk request error yang membutuhkan accessToken atau roomId. Semua respons error memakai bentuk { status, error, message }.",
      "item": [
        {
          "name": "401 - Protected Route Without Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));", "const json = pm.response.json();", "pm.test('Kontrak Unauthorized benar', () => { pm.expect(json.status).to.eql(401); pm.expect(json.error).to.eql('Unauthorized'); pm.expect(json.message).to.be.a('string'); });"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{apiUrl}}/users/me" }
        },
        {
          "name": "401 - Invalid Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));", "pm.test('Tidak membocorkan detail password', () => pm.expect(pm.response.json().error).to.eql('Unauthorized'));" ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@afksnap.id\",\n  \"password\": \"password-salah\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{apiUrl}}/auth/login" }
        },
        {
          "name": "400 - Password Confirmation Mismatch",
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('testEmail', `error.${Date.now()}@example.com`);"] } }, { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));", "pm.test('ValidationError', () => pm.expect(pm.response.json().error).to.eql('ValidationError'));" ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Error Test\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123!\",\n  \"passwordConfirmation\": \"TidakSama123!\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{apiUrl}}/auth/register" }
        },
        {
          "name": "400 - Invalid Birthday",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));", "pm.test('Pesan tanggal lahir', () => pm.expect(pm.response.json().message).to.include('Tanggal lahir'));" ] } }],
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Arief Demo\",\n  \"birthday\": \"bukan-tanggal\",\n  \"avatarAnimation\": \"none\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{apiUrl}}/users/me" }
        },
        {
          "name": "400 - Invalid Room Participant Limit",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));", "pm.test('ValidationError', () => pm.expect(pm.response.json().error).to.eql('ValidationError'));" ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Room Tidak Valid\",\n  \"maxParticipants\": 9\n}", "options": { "raw": { "language": "json" } } }, "url": "{{apiUrl}}/rooms" }
        },
        {
          "name": "404 - Join Unknown Room",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));", "pm.test('NotFound', () => pm.expect(pm.response.json().error).to.eql('NotFound'));" ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"TIDAKADA\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{apiUrl}}/rooms/join" }
        },
        {
          "name": "400 - Upload Without Photo",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));", "pm.test('Foto wajib dipilih', () => pm.expect(pm.response.json().message).to.include('Pilih foto'));" ] } }],
          "request": { "method": "POST", "header": [], "url": "{{apiUrl}}/rooms/{{roomId}}/photos", "description": "Gunakan roomId valid dari Create Room. Request sengaja tidak mengirim multipart photo." }
        },
        {
          "name": "403 - User Accessing Admin Report",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));", "pm.test('Forbidden', () => pm.expect(pm.response.json().error).to.eql('Forbidden'));" ] } }],
          "request": { "method": "GET", "header": [], "url": "{{apiUrl}}/admin/reports?period=daily", "description": "Gunakan accessToken akun demo/user, bukan adminToken." }
        },
        {
          "name": "400 - Malformed JSON",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));", "const json = pm.response.json();", "pm.test('InvalidJson aman', () => { pm.expect(json.error).to.eql('InvalidJson'); pm.expect(json.message).to.eql('Format JSON request tidak valid'); });" ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{", "options": { "raw": { "language": "json" } } }, "url": "{{apiUrl}}/auth/login" }
        },
        {
          "name": "404 - Unknown Endpoint",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));", "pm.test('Kontrak NotFound benar', () => pm.expect(pm.response.json()).to.include({ status: 404, error: 'NotFound' }));" ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/endpoint-tidak-ada" }
        }
      ]
    }
  ]
