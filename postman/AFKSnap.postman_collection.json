    {
      "name": "04 - Rooms",
      "item": [
        {
          "name": "List My Rooms",
          "request": { "method": "GET", "header": [], "url": "{{apiUrl}}/rooms" }
        },
        {
          "name": "Create Room",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Room dibuat', () => pm.response.to.have.status(201));", "const room = pm.response.json().data;", "pm.collectionVariables.set('roomId', String(room.id));", "pm.collectionVariables.set('roomCode', room.code);"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Room Postman\",\n  \"maxParticipants\": 6\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{apiUrl}}/rooms"
          }
        },
        {
          "name": "Join Room by Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{roomCode}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{apiUrl}}/rooms/join"
          }
        },
        {
          "name": "Get Room Detail",
          "request": { "method": "GET", "header": [], "url": "{{apiUrl}}/rooms/{{roomId}}" }
        },
        {
          "name": "Get Room Messages",
          "request": { "method": "GET", "header": [], "url": "{{apiUrl}}/rooms/{{roomId}}/messages" }
        },
        {
          "name": "Upload Room Photo",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Foto room terunggah', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('assetId', String(json.data.id));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "photo", "type": "file", "src": [] }] },
            "url": "{{apiUrl}}/rooms/{{roomId}}/photos",
            "description": "Pilih JPG, PNG, atau WebP maksimal 8 MB. Jalankan dua kali untuk generation grup."
          }
        },
        {
          "name": "Delete Room Photo",
          "request": { "method": "DELETE", "header": [], "url": "{{apiUrl}}/rooms/{{roomId}}/photos/{{assetId}}" }
        }
      ]
    },
