        {
          "name": "Create Solo Real Generation",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Job diterima', () => pm.response.to.have.status(202));", "const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('generationId', String(json.data.id));"] }
            }
