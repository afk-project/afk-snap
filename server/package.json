{
  "name": "afksnap-server",
  "version": "1.0.0",
  "description": "Backend API, credit wallet, OpenAI adapter, and realtime rooms for AFKSnap.",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon bin/www.js",
    "start": "node bin/www.js",
    "test": "jest --runInBand",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:accounts": "sequelize-cli db:seed --seed 202609160002-demo-users.js",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "openai": "^5.20.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
